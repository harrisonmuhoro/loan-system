# ==============================================================================
# LOAN MANAGEMENT SYSTEM — .gitignore
# ==============================================================================

# 1. Local configuration, environment files, and secrets
.env
.env.*
!.env.example
!.env.dist
/config/local.php
/config/config.local.php
/config/*.local.php
*.pem
*.key
*.crt

# 2. Dependencies and package managers
/vendor/
composer.phar
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Runtime logs and error reports
*.log
*.log.*
/logs/*
!/logs/.gitkeep
/api/logs/*
!/api/logs/.gitkeep
/pages/logs/*
!/pages/logs/.gitkeep
error_log
php_errors.log
xdebug.log

# 4. Private uploads, imported documents, and generated exports
/secure/**
!/secure/**/
!/secure/**/.gitkeep
!/secure/**/.htaccess
/uploads/**
!/uploads/**/
!/uploads/**/.gitkeep
!/uploads/**/.htaccess
/storage/**
!/storage/**/
!/storage/**/.gitkeep
!/storage/**/.htaccess
/tmp/**
!/tmp/**/
!/tmp/**/.gitkeep
/temp/**
!/temp/**/
!/temp/**/.gitkeep
/exports/**
!/exports/**/
!/exports/**/.gitkeep

# 5. Database backups, temporary dumps, and local test databases
# (Repository schema and migration SQL in /scripts and root remain tracked)
/backups/*
!/backups/.gitkeep
backup_*.json
backup_*.sql
dump_*.sql
*_dump.sql
*.bak
*.sql.gz
*.sql.zip
*.sqlite
*.sqlite3
*.db

# 6. Test artifacts, session caches, and profiling output
/.phpunit.result.cache
/.phpunit.cache/
/coverage/
*.cookies.txt
*.cookie
sess_*
/tests/tmp/
/php.exe
/.php-version

# 7. IDE, editor, and operating-system files
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/tasks.json
!/.vscode/launch.json
*.code-workspace
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini

# 8. Temporary editor and patch files
*.swp
*.swo
*~
*.tmp
*.temp
*.orig
*.rej
*.diff
*.patch

LEGACY_DEBT_AUDITABILITY_REMEDIATION_PHASE_12.md
LEGACY_DEBT_DATABASE_IMPLEMENTATION.md
LEGACY_RBAC_PHASE4_IMPLEMENTATION.md
LEGACY_MIGRATION_PHASE5_IMPLEMENTATION.md
LEGACY_IMPORT_PHASE3_IMPLEMENTATION.md
LEGACY_DEBT_SECURITY_AUDIT.md
LEGACY_DEBT_POST_IMPLEMENTATION_AUDIT.md