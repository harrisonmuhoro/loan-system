# Local configuration and secrets
.env
.env.*
!.env.example
/config/local.php
/config/config.local.php

# Composer dependencies and generated autoload files
/vendor/

# Runtime logs
*.log
/logs/
/api/logs/
/pages/logs/

# Private uploads, imported documents, and generated exports
/secure/*
!/secure/.gitkeep
/uploads/
/storage/
/tmp/
/temp/
/exports/

# Local database backups and generated dumps (keep schema/migration SQL tracked)
/backups/
backup_*.json
backup_*.sql
dump_*.sql
*_dump.sql
*.bak

# Test and tooling caches
/.phpunit.result.cache
/.phpunit.cache/
/php.exe
/.php-version

# IDE and operating-system files
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/tasks.json
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Temporary editor and patch files
*.swp
*.swo
*.tmp
*.temp
*.orig
*.rej
